# ---------- SECRETS (server only, never commit) ----------
DATABASE_URL=postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TEST_DATABASE_URL=            # optional: local Timescale; DB test suites skip if empty
SESSION_SECRET=               # openssl rand -base64 32
WORKER_SECRET=                # openssl rand -base64 32
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
SPECTRUM_PROJECT_ID=          # Photon project id (read automatically by spectrum-ts)
SPECTRUM_PROJECT_SECRET=      # Photon project secret
SPECTRUM_WEBHOOK_SECRET=      # optional, only for inbound replies (extension)
PHOTON_DASHBOARD_TOKEN=       # optional: from `npx @photon-ai/cli login`; auto-registers alert numbers
FIREBASE_PROJECT_ID=          # Firebase service account (Project settings → Service accounts)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=         # keep the \n escapes; wrap in double quotes
DEMO_ALERT_PHONE=             # optional, +1..., seed creates a demo alert contact

# ---------- SERVER CONFIG (not secret, server only) ----------
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
ELEVENLABS_VOICE_ID=          # from ElevenLabs voice library
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
TTS_MONTHLY_CHAR_BUDGET=18000
NOTIFY_MODE=photon            # photon | in_app
AI_MOCK=false                 # true forces all AI mocks (tests set this)
STORAGE_PROVIDER=db

# ---------- PUBLIC (shipped to the browser) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_FACE_MATCH_THRESHOLD=0.68
NEXT_PUBLIC_FIREBASE_API_KEY= # Firebase web app config (Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY= # Maps JavaScript API key (restrict to your site); blank = OpenStreetMap
