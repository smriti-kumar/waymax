{
  "name": "waymax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/reset.ts",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/notify-worker.ts",
    "tts:prewarm": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/prewarm-tts.ts",
    "verify:keys": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-keys.ts",
    "verify:gemini": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-gemini-models.ts",
    "postinstall": "node scripts/copy-human-models.mjs"
  },
  "dependencies": {
    "@google/genai": "2.26.0",
    "@vladmandic/human": "3.3.6",
    "bcryptjs": "3.0.3",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.45.3",
    "leaflet": "1.9.4",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "spectrum-ts": "12.10.1",
    "swr": "2.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "msw": "3.0.1",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22"
  }
}
